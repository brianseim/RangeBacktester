//@version=6
indicator("EvoD Trader — News Reversal Backtest", overlay=true, max_labels_count=500, max_lines_count=500)

// ============================================================
// EvoD TRADER — NEWS REVERSAL (SPIKE & REVERSE) BACKTEST
// Detects unusually large single-bar moves (spikes) and tracks
// the reversal trade + retest entry.
//
// SPIKE DETECTION: bar body >= spikeMultiplier × ATR(14)
// ENTRY 1 (E1):   first bar closing back beyond spike open (full rejection)
// ENTRY 2 (E2):   retest — prior close beyond level, wick back, close away
// STOP:           spike extreme (low for long reversal, high for short reversal)
// TARGETS:        50 / 100 / 200% of spike size from entry
// OUTCOME MODEL:  exclusive buckets summing to 100%
//                 STOP / 50% / 100% / 200% / TO+ / TO-
//                 Furthest target reached wins.
//                 Touch 50% then stop = 50% (win).
// ============================================================

// ------------------------------------------------------------
// INPUTS
// ------------------------------------------------------------
startDate       = input.time(timestamp("2025-06-01 00:00:00"), "Start Date",   group="Date Range")
endDate         = input.time(timestamp("2026-06-22 23:59:59"), "End Date",     group="Date Range")

tz              = input.string("America/Chicago", "Timezone",
     options=["America/Chicago","America/New_York","America/Los_Angeles","Europe/London","UTC"],
     group="Session", tooltip="America/Chicago = Central Time")
sessionStartHM  = input.int(745,  "Session START (HHMM) — watch for spikes after this", group="Session")
sessionEndHM    = input.int(1200, "Session END (HHMM)  — no new entries after this",    group="Session")
exitHM          = input.int(1600, "Timeout EXIT (HHMM)",                                group="Session")

atrLen          = input.int(14,   "ATR Length",                      group="Risk")
spikeMultiplier = input.float(3.0,"Spike detection: body >= X × ATR", group="Risk", minval=1.0, step=0.5,
     tooltip="A bar whose body is this many times larger than ATR(14) is flagged as a spike")
atrStopMult     = input.float(0.0,"Additional ATR buffer on stop",    group="Risk", minval=0.0, step=0.1,
     tooltip="0 = stop at spike extreme only. Add ATR buffer for extra room.")

show_labels     = input.bool(true, "Show Signal Labels",    group="Display")
show_spike      = input.bool(true, "Highlight Spike Bars",  group="Display")
recent_only     = input.bool(true, "Limit drawings: recent N days", group="Display")
recent_days     = input.int(20,    "How many recent days",  group="Display", minval=1, maxval=250)
spike_col       = input.color(color.new(color.yellow, 70),  "Spike highlight color", group="Display")

alert_e1        = input.bool(true, "Alert: E1 reversal entry",  group="Alerts")
alert_e2        = input.bool(true, "Alert: E2 retest entry",    group="Alerts")

// ------------------------------------------------------------
// HOLIDAY EXCLUSION — US federal holidays
// ------------------------------------------------------------
_hm  = month(time, tz)
_hd  = dayofmonth(time, tz)
_hy  = year(time, tz)
_ha  = _hy==2025 and _hm==7  and _hd==4
_hb  = _hy==2025 and _hm==9  and _hd==1
_hc  = _hy==2025 and _hm==11 and _hd==11
_hdd = _hy==2025 and _hm==11 and _hd==27
_he  = _hy==2025 and _hm==11 and _hd==28
_hf  = _hy==2025 and _hm==12 and _hd==25
_hg  = _hy==2025 and _hm==12 and _hd==26
_hh  = _hy==2026 and _hm==1  and _hd==1
_hi  = _hy==2026 and _hm==1  and _hd==19
_hj  = _hy==2026 and _hm==2  and _hd==16
_hk  = _hy==2026 and _hm==4  and _hd==3
_hl  = _hy==2026 and _hm==5  and _hd==25
isHol = _ha or _hb or _hc or _hdd or _he or _hf or _hg or _hh or _hi or _hj or _hk or _hl

// ------------------------------------------------------------
// SESSION HELPERS
// ------------------------------------------------------------
hm2min(hm) => math.floor(hm / 100) * 60 + (hm % 100)
barHour        = hour(time, tz)
barMinute      = minute(time, tz)
barTimeMinutes = barHour * 60 + barMinute

sessionStartM  = hm2min(sessionStartHM)
sessionEndM    = hm2min(sessionEndHM)
exitM          = hm2min(exitHM)

inSession      = barTimeMinutes >= sessionStartM and barTimeMinutes < sessionEndM
inDateRange    = time >= startDate and time <= endDate
validDay       = inDateRange and not isHol

dw     = dayofweek(time, tz)
dowNow = dw == dayofweek.monday ? 0 : dw == dayofweek.tuesday ? 1 : dw == dayofweek.wednesday ? 2 : dw == dayofweek.thursday ? 3 : 4

atr14  = ta.atr(atrLen)

// ------------------------------------------------------------
// SPIKE DETECTION
// A spike bar: body size >= spikeMultiplier × ATR
// Direction: down-spike (close < open) or up-spike (close > open)
// ------------------------------------------------------------
bodySize    = math.abs(close - open)
isSpike     = bodySize >= spikeMultiplier * atr14 and inSession and validDay
isDownSpike = isSpike and close < open   // spike DOWN → watch for LONG reversal
isUpSpike   = isSpike and close > open   // spike UP   → watch for SHORT reversal

// Highlight spike bars
bgcolor(show_spike and isDownSpike ? color.new(color.red,    80) : na)
bgcolor(show_spike and isUpSpike   ? color.new(color.green,  80) : na)

// Spike anchor labels
if isDownSpike and show_labels
    label.new(time, high, xloc=xloc.bar_time,
         text="⚡↓\n" + str.tostring(bodySize, "#.##"),
         style=label.style_label_down,
         color=color.new(color.red, 20),
         textcolor=color.white, size=size.small)

if isUpSpike and show_labels
    label.new(time, low, xloc=xloc.bar_time,
         text="⚡↑\n" + str.tostring(bodySize, "#.##"),
         style=label.style_label_up,
         color=color.new(color.green, 20),
         textcolor=color.white, size=size.small)

// ------------------------------------------------------------
// DAILY STATE — spike tracking + trade state
// ------------------------------------------------------------
var bool  spikeArmed    = false   // a spike fired, watching for reversal
var bool  spikeIsDown   = false   // spike direction (down = watch for long)
var float spikeOpen     = na      // spike candle open (reversal trigger level)
var float spikeExtreme  = na      // spike candle extreme (stop level)
var float spikeSize     = na      // spike body size (target measurement)
var int   spikeBar      = na      // bar_index of spike

var bool  e1_done       = false   // E1 taken today
var bool  e2_done       = false   // E2 taken today

// ── E1 position state ──
var bool  a1_in    = false
var bool  a1_long  = false
var float a1_stop  = na
var float a1_t50   = na
var float a1_t100  = na
var float a1_t200  = na
var float a1_entry = na
var bool  a1_h50   = false
var bool  a1_h100  = false
var bool  a1_h200  = false
var int   a1_dow   = 0
var int   a1_ebar  = na

// ── E2 position state ──
var bool  a2_in    = false
var bool  a2_long  = false
var float a2_stop  = na
var float a2_t50   = na
var float a2_t100  = na
var float a2_t200  = na
var float a2_entry = na
var bool  a2_h50   = false
var bool  a2_h100  = false
var bool  a2_h200  = false
var int   a2_dow   = 0
var int   a2_ebar  = na

// ------------------------------------------------------------
// OUTCOME COUNTERS — exclusive buckets
// ------------------------------------------------------------
var int e1l_tot=0
var int e1l_stop=0
var int e1l_t50=0
var int e1l_t100=0
var int e1l_t200=0
var int e1l_fw=0
var int e1l_fl=0
var int e1s_tot=0
var int e1s_stop=0
var int e1s_t50=0
var int e1s_t100=0
var int e1s_t200=0
var int e1s_fw=0
var int e1s_fl=0
var int e2l_tot=0
var int e2l_stop=0
var int e2l_t50=0
var int e2l_t100=0
var int e2l_t200=0
var int e2l_fw=0
var int e2l_fl=0
var int e2s_tot=0
var int e2s_stop=0
var int e2s_t50=0
var int e2s_t100=0
var int e2s_t200=0
var int e2s_fw=0
var int e2s_fl=0

var dow_sig  = array.new_int(5, 0)
var dow_lsig = array.new_int(5, 0)
var dow_ssig = array.new_int(5, 0)
var dow_stop = array.new_int(5, 0)
var dow_t50  = array.new_int(5, 0)
var dow_t100 = array.new_int(5, 0)
var dow_t200 = array.new_int(5, 0)
var dow_fw   = array.new_int(5, 0)
var dow_fl   = array.new_int(5, 0)

// ------------------------------------------------------------
// DAILY RESET — at session start
// ------------------------------------------------------------
if barTimeMinutes >= sessionStartM and barTimeMinutes[1] < sessionStartM
    spikeArmed := false
    spikeIsDown := false
    spikeOpen := na
    spikeExtreme := na
    spikeSize := na
    spikeBar := na
    e1_done := false
    e2_done := false
    a1_in := false
    a2_in := false

// ------------------------------------------------------------
// ARM SPIKE — store spike details when detected
// Only arm if not already in a trade on that direction
// Multiple spikes in a day: re-arm on each new spike (latest wins)
// ------------------------------------------------------------
if isDownSpike and validDay
    spikeArmed   := true
    spikeIsDown  := true
    spikeOpen    := open        // reversal trigger: close back above spike open
    spikeExtreme := low         // stop: below spike low
    spikeSize    := bodySize
    spikeBar     := bar_index

if isUpSpike and validDay
    spikeArmed   := true
    spikeIsDown  := false
    spikeOpen    := open        // reversal trigger: close back below spike open
    spikeExtreme := high        // stop: above spike high
    spikeSize    := bodySize
    spikeBar     := bar_index

// ------------------------------------------------------------
// RECORD RESULT HELPER (inline — Pine v6)
// ------------------------------------------------------------

// Result recording vars (Pine v6: no global modification in functions)
var bool rr_go=false
var bool rr_isLong=false
var bool rr_isE2=false
var int  rr_out=0
var int  rr_dow=0

// ------------------------------------------------------------
// E1 RESOLUTION
// ------------------------------------------------------------
a1_out = -1
if a1_in and validDay and bar_index > a1_ebar
    if a1_long
        if high >= a1_t50  and not a1_h50 
            a1_h50  := true
        if high >= a1_t100 and not a1_h100
            a1_h100 := true
        if high >= a1_t200 and not a1_h200
            a1_h200 := true
        if close < a1_stop
            a1_out := a1_h200 ? 3 : a1_h100 ? 2 : a1_h50 ? 1 : 0
    else
        if low <= a1_t50  and not a1_h50 
            a1_h50  := true
        if low <= a1_t100 and not a1_h100
            a1_h100 := true
        if low <= a1_t200 and not a1_h200
            a1_h200 := true
        if close > a1_stop
            a1_out := a1_h200 ? 3 : a1_h100 ? 2 : a1_h50 ? 1 : 0

if barTimeMinutes >= exitM and barTimeMinutes[1] < exitM and a1_in and validDay and a1_out == -1
    fw = a1_long ? (close > a1_entry) : (close < a1_entry)
    a1_out := a1_h200 ? 3 : a1_h100 ? 2 : a1_h50 ? 1 : (fw ? 4 : 5)

if a1_out >= 0
    if show_labels
        oTxt = a1_out==0 ? "STOP" : a1_out==1 ? "50%" : a1_out==2 ? "100%" : a1_out==3 ? "200%" : a1_out==4 ? "TO+" : "TO-"
        oCol = a1_out==0 ? color.red : a1_out==3 ? color.aqua : (a1_out==1 or a1_out==2) ? color.lime : a1_out==4 ? color.teal : color.gray
        label.new(time, a1_long ? high : low, xloc=xloc.bar_time,
             text="E1:" + oTxt,
             style=a1_long ? label.style_label_down : label.style_label_up,
             color=color.new(oCol, 30), textcolor=color.white, size=size.tiny)
    rr_isLong := a1_long
    rr_isE2   := false
    rr_out    := a1_out
    rr_dow    := a1_dow
    rr_go     := true
    a1_in := false

// ------------------------------------------------------------
// E2 RESOLUTION
// ------------------------------------------------------------
a2_out = -1
if a2_in and validDay and bar_index > a2_ebar
    if a2_long
        if high >= a2_t50  and not a2_h50 
            a2_h50  := true
        if high >= a2_t100 and not a2_h100
            a2_h100 := true
        if high >= a2_t200 and not a2_h200
            a2_h200 := true
        if close < a2_stop
            a2_out := a2_h200 ? 3 : a2_h100 ? 2 : a2_h50 ? 1 : 0
    else
        if low <= a2_t50  and not a2_h50 
            a2_h50  := true
        if low <= a2_t100 and not a2_h100
            a2_h100 := true
        if low <= a2_t200 and not a2_h200
            a2_h200 := true
        if close > a2_stop
            a2_out := a2_h200 ? 3 : a2_h100 ? 2 : a2_h50 ? 1 : 0

if barTimeMinutes >= exitM and barTimeMinutes[1] < exitM and a2_in and validDay and a2_out == -1
    fw2 = a2_long ? (close > a2_entry) : (close < a2_entry)
    a2_out := a2_h200 ? 3 : a2_h100 ? 2 : a2_h50 ? 1 : (fw2 ? 4 : 5)

if a2_out >= 0
    if show_labels
        oTxt2 = a2_out==0 ? "STOP" : a2_out==1 ? "50%" : a2_out==2 ? "100%" : a2_out==3 ? "200%" : a2_out==4 ? "TO+" : "TO-"
        oCol2 = a2_out==0 ? color.red : a2_out==3 ? color.aqua : (a2_out==1 or a2_out==2) ? color.lime : a2_out==4 ? color.teal : color.gray
        label.new(time, a2_long ? high : low, xloc=xloc.bar_time,
             text="E2:" + oTxt2,
             style=a2_long ? label.style_label_down : label.style_label_up,
             color=color.new(oCol2, 50), textcolor=color.white, size=size.tiny)
    rr_isLong := a2_long
    rr_isE2   := true
    rr_out    := a2_out
    rr_dow    := a2_dow
    rr_go     := true
    a2_in := false

// ------------------------------------------------------------
// E1 ENTRY — first bar closing back beyond spike open
// DOWN spike → long when close > spikeOpen
// UP spike   → short when close < spikeOpen
// ------------------------------------------------------------
if spikeArmed and not e1_done and not a1_in and inSession and validDay and bar_index > spikeBar
    if spikeIsDown and close > spikeOpen
        // Long reversal confirmed
        e1_done      := true
        a1_in        := true
        a1_long      := true
        a1_stop      := spikeExtreme - atr14 * atrStopMult
        a1_entry     := close
        a1_t50       := close + spikeSize * 0.5
        a1_t100      := close + spikeSize * 1.0
        a1_t200      := close + spikeSize * 2.0
        a1_h50       := false
        a1_h100      := false
        a1_h200      := false
        a1_dow       := dowNow
        a1_ebar      := bar_index
        if show_labels
            label.new(time, low, xloc=xloc.bar_time,
                 text="E1-L\n" + str.tostring(close, "#.##"),
                 style=label.style_label_up,
                 color=color.new(color.green, 20),
                 textcolor=color.white, size=size.small)
        if alert_e1
            alert("News Reversal E1 LONG @ " + str.tostring(close), alert.freq_once_per_bar_close)

    else if not spikeIsDown and close < spikeOpen
        // Short reversal confirmed
        e1_done      := true
        a1_in        := true
        a1_long      := false
        a1_stop      := spikeExtreme + atr14 * atrStopMult
        a1_entry     := close
        a1_t50       := close - spikeSize * 0.5
        a1_t100      := close - spikeSize * 1.0
        a1_t200      := close - spikeSize * 2.0
        a1_h50       := false
        a1_h100      := false
        a1_h200      := false
        a1_dow       := dowNow
        a1_ebar      := bar_index
        if show_labels
            label.new(time, high, xloc=xloc.bar_time,
                 text="E1-S\n" + str.tostring(close, "#.##"),
                 style=label.style_label_down,
                 color=color.new(color.red, 20),
                 textcolor=color.white, size=size.small)
        if alert_e1
            alert("News Reversal E1 SHORT @ " + str.tostring(close), alert.freq_once_per_bar_close)

// ------------------------------------------------------------
// E2 ENTRY — retest of spike open level
// Prior bar closed beyond spike open, this bar wicks back, closes away
// ------------------------------------------------------------
if spikeArmed and e1_done and not e2_done and not a2_in and inSession and validDay and bar_index > spikeBar
    if spikeIsDown
        // Long retest: prior close above spike open, wick back down to it, close back above
        if close[1] > spikeOpen and low <= spikeOpen and close > spikeOpen
            e2_done   := true
            a2_in     := true
            a2_long   := true
            a2_stop   := spikeExtreme - atr14 * atrStopMult
            a2_entry  := close
            a2_t50    := close + spikeSize * 0.5
            a2_t100   := close + spikeSize * 1.0
            a2_t200   := close + spikeSize * 2.0
            a2_h50    := false
            a2_h100   := false
            a2_h200   := false
            a2_dow    := dowNow
            a2_ebar   := bar_index
            if show_labels
                label.new(time, low, xloc=xloc.bar_time,
                     text="E2-L\n" + str.tostring(close, "#.##"),
                     style=label.style_label_up,
                     color=color.new(color.teal, 20),
                     textcolor=color.white, size=size.small)
            if alert_e2
                alert("News Reversal E2 LONG retest @ " + str.tostring(close), alert.freq_once_per_bar_close)
    else
        // Short retest: prior close below spike open, wick back up, close back below
        if close[1] < spikeOpen and high >= spikeOpen and close < spikeOpen
            e2_done   := true
            a2_in     := true
            a2_long   := false
            a2_stop   := spikeExtreme + atr14 * atrStopMult
            a2_entry  := close
            a2_t50    := close - spikeSize * 0.5
            a2_t100   := close - spikeSize * 1.0
            a2_t200   := close - spikeSize * 2.0
            a2_h50    := false
            a2_h100   := false
            a2_h200   := false
            a2_dow    := dowNow
            a2_ebar   := bar_index
            if show_labels
                label.new(time, high, xloc=xloc.bar_time,
                     text="E2-S\n" + str.tostring(close, "#.##"),
                     style=label.style_label_down,
                     color=color.new(color.orange, 20),
                     textcolor=color.white, size=size.small)
            if alert_e2
                alert("News Reversal E2 SHORT retest @ " + str.tostring(close), alert.freq_once_per_bar_close)

// ------------------------------------------------------------
// PROCESS RESULT
// ------------------------------------------------------------
if rr_go
    if rr_isLong and not rr_isE2
        e1l_tot += 1
        if rr_out==0
            e1l_stop += 1
        if rr_out==1
            e1l_t50 += 1
        if rr_out==2
            e1l_t100 += 1
        if rr_out==3
            e1l_t200 += 1
        if rr_out==4
            e1l_fw += 1
        if rr_out==5
            e1l_fl += 1
        array.set(dow_lsig, rr_dow, array.get(dow_lsig, rr_dow) + 1)
    else if not rr_isLong and not rr_isE2
        e1s_tot += 1
        if rr_out==0
            e1s_stop += 1
        if rr_out==1
            e1s_t50 += 1
        if rr_out==2
            e1s_t100 += 1
        if rr_out==3
            e1s_t200 += 1
        if rr_out==4
            e1s_fw += 1
        if rr_out==5
            e1s_fl += 1
        array.set(dow_ssig, rr_dow, array.get(dow_ssig, rr_dow) + 1)
    else if rr_isLong and rr_isE2
        e2l_tot += 1
        if rr_out==0
            e2l_stop += 1
        if rr_out==1
            e2l_t50 += 1
        if rr_out==2
            e2l_t100 += 1
        if rr_out==3
            e2l_t200 += 1
        if rr_out==4
            e2l_fw += 1
        if rr_out==5
            e2l_fl += 1
        array.set(dow_lsig, rr_dow, array.get(dow_lsig, rr_dow) + 1)
    else
        e2s_tot += 1
        if rr_out==0
            e2s_stop += 1
        if rr_out==1
            e2s_t50 += 1
        if rr_out==2
            e2s_t100 += 1
        if rr_out==3
            e2s_t200 += 1
        if rr_out==4
            e2s_fw += 1
        if rr_out==5
            e2s_fl += 1
        array.set(dow_ssig, rr_dow, array.get(dow_ssig, rr_dow) + 1)
    array.set(dow_sig, rr_dow, array.get(dow_sig, rr_dow) + 1)
    if rr_out==0
        array.set(dow_stop, rr_dow, array.get(dow_stop, rr_dow) + 1)
    if rr_out==1
        array.set(dow_t50, rr_dow, array.get(dow_t50, rr_dow) + 1)
    if rr_out==2
        array.set(dow_t100, rr_dow, array.get(dow_t100, rr_dow) + 1)
    if rr_out==3
        array.set(dow_t200, rr_dow, array.get(dow_t200, rr_dow) + 1)
    if rr_out==4
        array.set(dow_fw, rr_dow, array.get(dow_fw, rr_dow) + 1)
    if rr_out==5
        array.set(dow_fl, rr_dow, array.get(dow_fl, rr_dow) + 1)
    rr_go := false

// ------------------------------------------------------------
// TABLES
// ------------------------------------------------------------
pct(n, d) => d > 0 ? str.tostring(math.round(n / d * 100)) + "%" : "—"

var table t1 = table.new(position.top_right, 5, 11,
     bgcolor=color.new(color.black, 10),
     border_color=color.gray, border_width=1,
     frame_color=color.gray, frame_width=1)

var table t2 = table.new(position.bottom_right, 7, 12,
     bgcolor=color.new(color.black, 10),
     border_color=color.gray, border_width=1,
     frame_color=color.gray, frame_width=1)

if barstate.islast
    // Cumulative targets
    e1l_c50  = e1l_t50 + e1l_t100 + e1l_t200
    e1l_c100 = e1l_t100 + e1l_t200
    e1l_win  = e1l_fw + e1l_c50
    e1l_loss = e1l_stop + e1l_fl
    e1s_c50  = e1s_t50 + e1s_t100 + e1s_t200
    e1s_c100 = e1s_t100 + e1s_t200
    e1s_win  = e1s_fw + e1s_c50
    e1s_loss = e1s_stop + e1s_fl
    e2l_c50  = e2l_t50 + e2l_t100 + e2l_t200
    e2l_c100 = e2l_t100 + e2l_t200
    e2l_win  = e2l_fw + e2l_c50
    e2l_loss = e2l_stop + e2l_fl
    e2s_c50  = e2s_t50 + e2s_t100 + e2s_t200
    e2s_c100 = e2s_t100 + e2s_t200
    e2s_win  = e2s_fw + e2s_c50
    e2s_loss = e2s_stop + e2s_fl

    hc = color.new(color.purple, 20)
    table.cell(t1,0,0,"METRIC",   text_color=color.yellow, text_size=size.small, bgcolor=hc)
    table.cell(t1,1,0,"E1 LONG",  text_color=color.yellow, text_size=size.small, bgcolor=hc)
    table.cell(t1,2,0,"E1 SHORT", text_color=color.yellow, text_size=size.small, bgcolor=hc)
    table.cell(t1,3,0,"E2 LONG",  text_color=color.yellow, text_size=size.small, bgcolor=hc)
    table.cell(t1,4,0,"E2 SHORT", text_color=color.yellow, text_size=size.small, bgcolor=hc)

    table.cell(t1,0,1,"Signals",  text_color=color.white, text_size=size.small)
    table.cell(t1,1,1,str.tostring(e1l_tot), text_color=color.white, text_size=size.small)
    table.cell(t1,2,1,str.tostring(e1s_tot), text_color=color.white, text_size=size.small)
    table.cell(t1,3,1,str.tostring(e2l_tot), text_color=color.white, text_size=size.small)
    table.cell(t1,4,1,str.tostring(e2s_tot), text_color=color.white, text_size=size.small)

    table.cell(t1,0,2,"Stop",     text_color=color.red, text_size=size.small)
    table.cell(t1,1,2,pct(e1l_stop,e1l_tot), text_color=color.red, text_size=size.small)
    table.cell(t1,2,2,pct(e1s_stop,e1s_tot), text_color=color.red, text_size=size.small)
    table.cell(t1,3,2,pct(e2l_stop,e2l_tot), text_color=color.red, text_size=size.small)
    table.cell(t1,4,2,pct(e2s_stop,e2s_tot), text_color=color.red, text_size=size.small)

    table.cell(t1,0,3,"Timeout L", text_color=color.gray, text_size=size.small)
    table.cell(t1,1,3,pct(e1l_fl,e1l_tot), text_color=color.gray, text_size=size.small)
    table.cell(t1,2,3,pct(e1s_fl,e1s_tot), text_color=color.gray, text_size=size.small)
    table.cell(t1,3,3,pct(e2l_fl,e2l_tot), text_color=color.gray, text_size=size.small)
    table.cell(t1,4,3,pct(e2s_fl,e2s_tot), text_color=color.gray, text_size=size.small)

    lc = color.new(color.red, 55)
    table.cell(t1,0,4,"LOSS RATE", text_color=color.white, text_size=size.small, bgcolor=lc)
    table.cell(t1,1,4,pct(e1l_loss,e1l_tot), text_color=color.white, text_size=size.small, bgcolor=lc)
    table.cell(t1,2,4,pct(e1s_loss,e1s_tot), text_color=color.white, text_size=size.small, bgcolor=lc)
    table.cell(t1,3,4,pct(e2l_loss,e2l_tot), text_color=color.white, text_size=size.small, bgcolor=lc)
    table.cell(t1,4,4,pct(e2s_loss,e2s_tot), text_color=color.white, text_size=size.small, bgcolor=lc)

    table.cell(t1,0,5,"Timeout W", text_color=color.teal, text_size=size.small)
    table.cell(t1,1,5,pct(e1l_fw,e1l_tot), text_color=color.teal, text_size=size.small)
    table.cell(t1,2,5,pct(e1s_fw,e1s_tot), text_color=color.teal, text_size=size.small)
    table.cell(t1,3,5,pct(e2l_fw,e2l_tot), text_color=color.teal, text_size=size.small)
    table.cell(t1,4,5,pct(e2s_fw,e2s_tot), text_color=color.teal, text_size=size.small)

    table.cell(t1,0,6,"50%",  text_color=color.lime, text_size=size.small)
    table.cell(t1,1,6,pct(e1l_c50,e1l_tot),  text_color=color.lime, text_size=size.small)
    table.cell(t1,2,6,pct(e1s_c50,e1s_tot),  text_color=color.lime, text_size=size.small)
    table.cell(t1,3,6,pct(e2l_c50,e2l_tot),  text_color=color.lime, text_size=size.small)
    table.cell(t1,4,6,pct(e2s_c50,e2s_tot),  text_color=color.lime, text_size=size.small)

    table.cell(t1,0,7,"100%", text_color=color.lime, text_size=size.small)
    table.cell(t1,1,7,pct(e1l_c100,e1l_tot), text_color=color.lime, text_size=size.small)
    table.cell(t1,2,7,pct(e1s_c100,e1s_tot), text_color=color.lime, text_size=size.small)
    table.cell(t1,3,7,pct(e2l_c100,e2l_tot), text_color=color.lime, text_size=size.small)
    table.cell(t1,4,7,pct(e2s_c100,e2s_tot), text_color=color.lime, text_size=size.small)

    table.cell(t1,0,8,"200%", text_color=color.aqua, text_size=size.small)
    table.cell(t1,1,8,pct(e1l_t200,e1l_tot), text_color=color.aqua, text_size=size.small)
    table.cell(t1,2,8,pct(e1s_t200,e1s_tot), text_color=color.aqua, text_size=size.small)
    table.cell(t1,3,8,pct(e2l_t200,e2l_tot), text_color=color.aqua, text_size=size.small)
    table.cell(t1,4,8,pct(e2s_t200,e2s_tot), text_color=color.aqua, text_size=size.small)

    wc = color.new(color.green, 50)
    table.cell(t1,0,9,"WIN RATE", text_color=color.white, text_size=size.small, bgcolor=wc)
    table.cell(t1,1,9,pct(e1l_win,e1l_tot), text_color=color.white, text_size=size.small, bgcolor=wc)
    table.cell(t1,2,9,pct(e1s_win,e1s_tot), text_color=color.white, text_size=size.small, bgcolor=wc)
    table.cell(t1,3,9,pct(e2l_win,e2l_tot), text_color=color.white, text_size=size.small, bgcolor=wc)
    table.cell(t1,4,9,pct(e2s_win,e2s_tot), text_color=color.white, text_size=size.small, bgcolor=wc)

    table.cell(t1,0,10,
         "EvoD News Reversal  ·  Spike ≥ " + str.tostring(spikeMultiplier) + "× ATR(" + str.tostring(atrLen) + ")  ·  " + tz,
         text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.purple, 40))

    // DAY OF WEEK TABLE
    days = array.from("MON","TUE","WED","THU","FRI")
    hc2  = color.new(color.purple, 30)
    table.cell(t2,0,0,"METRIC", text_color=color.yellow, text_size=size.small, bgcolor=hc2)
    for i = 0 to 4
        table.cell(t2, i+1, 0, array.get(days,i), text_color=color.yellow, text_size=size.small, bgcolor=hc2)
    table.cell(t2,6,0,"TOTAL", text_color=color.yellow, text_size=size.small, bgcolor=hc2)

    totalSig = e1l_tot + e1s_tot + e2l_tot + e2s_tot
    table.cell(t2,0,1,"Signals", text_color=color.white, text_size=size.small)
    for i = 0 to 4
        table.cell(t2, i+1, 1, str.tostring(array.get(dow_sig,i)), text_color=color.white, text_size=size.small)
    table.cell(t2,6,1,str.tostring(totalSig), text_color=color.white, text_size=size.small)

    table.cell(t2,0,2,"→ Long", text_color=color.lime, text_size=size.small)
    for i = 0 to 4
        table.cell(t2, i+1, 2, str.tostring(array.get(dow_lsig,i)), text_color=color.lime, text_size=size.small)
    table.cell(t2,6,2,str.tostring(e1l_tot+e2l_tot), text_color=color.lime, text_size=size.small)

    table.cell(t2,0,3,"→ Short", text_color=color.red, text_size=size.small)
    for i = 0 to 4
        table.cell(t2, i+1, 3, str.tostring(array.get(dow_ssig,i)), text_color=color.red, text_size=size.small)
    table.cell(t2,6,3,str.tostring(e1s_tot+e2s_tot), text_color=color.red, text_size=size.small)

    table.cell(t2,0,4,"Stop", text_color=color.red, text_size=size.small)
    for i = 0 to 4
        table.cell(t2, i+1, 4, pct(array.get(dow_stop,i), array.get(dow_sig,i)), text_color=color.red, text_size=size.small)
    table.cell(t2,6,4,pct(e1l_stop+e1s_stop+e2l_stop+e2s_stop,totalSig), text_color=color.red, text_size=size.small)

    table.cell(t2,0,5,"Timeout L", text_color=color.gray, text_size=size.small)
    for i = 0 to 4
        table.cell(t2, i+1, 5, pct(array.get(dow_fl,i), array.get(dow_sig,i)), text_color=color.gray, text_size=size.small)
    table.cell(t2,6,5,pct(e1l_fl+e1s_fl+e2l_fl+e2s_fl,totalSig), text_color=color.gray, text_size=size.small)

    lc2 = color.new(color.red, 55)
    table.cell(t2,0,6,"LOSS RATE", text_color=color.white, text_size=size.small, bgcolor=lc2)
    for i = 0 to 4
        dloss = array.get(dow_stop,i) + array.get(dow_fl,i)
        table.cell(t2, i+1, 6, pct(dloss, array.get(dow_sig,i)), text_color=color.white, text_size=size.small, bgcolor=lc2)
    table.cell(t2,6,6,pct(e1l_loss+e1s_loss+e2l_loss+e2s_loss,totalSig), text_color=color.white, text_size=size.small, bgcolor=lc2)

    table.cell(t2,0,7,"Timeout W", text_color=color.teal, text_size=size.small)
    for i = 0 to 4
        table.cell(t2, i+1, 7, pct(array.get(dow_fw,i), array.get(dow_sig,i)), text_color=color.teal, text_size=size.small)
    table.cell(t2,6,7,pct(e1l_fw+e1s_fw+e2l_fw+e2s_fw,totalSig), text_color=color.teal, text_size=size.small)

    table.cell(t2,0,8,"50%", text_color=color.lime, text_size=size.small)
    for i = 0 to 4
        dc50 = array.get(dow_t50,i) + array.get(dow_t100,i) + array.get(dow_t200,i)
        table.cell(t2, i+1, 8, pct(dc50, array.get(dow_sig,i)), text_color=color.lime, text_size=size.small)
    table.cell(t2,6,8,pct(e1l_c50+e1s_c50+e2l_c50+e2s_c50,totalSig), text_color=color.lime, text_size=size.small)

    table.cell(t2,0,9,"100%", text_color=color.lime, text_size=size.small)
    for i = 0 to 4
        dc100 = array.get(dow_t100,i) + array.get(dow_t200,i)
        table.cell(t2, i+1, 9, pct(dc100, array.get(dow_sig,i)), text_color=color.lime, text_size=size.small)
    table.cell(t2,6,9,pct(e1l_c100+e1s_c100+e2l_c100+e2s_c100,totalSig), text_color=color.lime, text_size=size.small)

    table.cell(t2,0,10,"200%", text_color=color.aqua, text_size=size.small)
    for i = 0 to 4
        table.cell(t2, i+1, 10, pct(array.get(dow_t200,i), array.get(dow_sig,i)), text_color=color.aqua, text_size=size.small)
    table.cell(t2,6,10,pct(e1l_t200+e1s_t200+e2l_t200+e2s_t200,totalSig), text_color=color.aqua, text_size=size.small)

    wc2 = color.new(color.green, 50)
    table.cell(t2,0,11,"WIN RATE", text_color=color.white, text_size=size.small, bgcolor=wc2)
    for i = 0 to 4
        dwin = array.get(dow_fw,i) + array.get(dow_t50,i) + array.get(dow_t100,i) + array.get(dow_t200,i)
        table.cell(t2, i+1, 11, pct(dwin, array.get(dow_sig,i)), text_color=color.white, text_size=size.small, bgcolor=wc2)
    totalWin = e1l_win + e1s_win + e2l_win + e2s_win
    table.cell(t2,6,11,pct(totalWin,totalSig), text_color=color.white, text_size=size.small, bgcolor=wc2)

// Scale anchor
plot(close, "scale_anchor", color=color.new(color.gray, 100), editable=false)
